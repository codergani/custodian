# Copy this file to .env and fill in your own values from:
# Supabase Dashboard → your Custodian project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Lemon Squeezy Web Payment Checkout URLs (from Lemon Squeezy Dashboard → Products → Share)
VITE_LEMON_SQUEEZY_PRO_URL=https://yourstore.lemonsqueezy.com/buy/pro-checkout-id
VITE_LEMON_SQUEEZY_TEAM_URL=https://yourstore.lemonsqueezy.com/buy/team-checkout-id

# Resend Watchdog Email Alerts
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev


