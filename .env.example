# Copy this file to .env and fill in your own values from:
# Supabase Dashboard → your Custodian project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# PayPal Client ID for Web Billing (from developer.paypal.com → Apps & Credentials)
# Leave blank or default to run in local Sandbox Mock Mode
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id-here

# Resend Watchdog Email Alerts
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev

# Founder & Admin Email (grants Founder Access Desk)
VITE_FOUNDER_EMAIL=founder@yourdomain.com
